# --- LLM (P5). Use "stub" for offline runs; "hosted" requires LLM_API_KEY. ---
LLM_PROVIDER=stub
LLM_MODEL=
LLM_API_KEY=

# Optional: any OpenAI-compatible /chat/completions endpoint. Leave unset for
# api.openai.com. Anthropic's native API is not OpenAI-compatible.
# LLM_ENDPOINT=https://api.groq.com/openai/v1/chat/completions

# Optional: endpoint for LLM_PROVIDER=local (Ollama by default).
# LLM_BASE_URL=http://localhost:11434

# --- Embeddings / vector store (P3) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_DIR=data/chroma
COLLECTION_NAME=mf_faq

# --- Retrieval tuning (values measured in P9 by eval/run_eval.py) ---
# Fact recall is driven entirely by TOP_K: 3 -> 3/6, 5 -> 5/6, 10 -> 6/6 expected
# facts found. MIN_SIMILARITY did not affect recall at any value tested, so it
# stays mid-range. Do not change these without re-running the sweep.
TOP_K=10
MIN_SIMILARITY=0.30

# --- Generation ---
LLM_TEMPERATURE=0.0
MAX_SENTENCES=3

# --- Copy shown in the UI (verbatim from the project brief) ---
DISCLAIMER=Facts-only. No investment advice.

# --- Keep the HuggingFace model cache inside the project so runs work offline ---
HF_HOME=./.cache/hf

# --- Ingestion politeness (P1) ---
REQUEST_TIMEOUT=30
REQUEST_DELAY_SECONDS=1.0
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36
